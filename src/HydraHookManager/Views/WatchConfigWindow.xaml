<ui:FluentWindow x:Class="HydraHookManager.Views.WatchConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Watch &amp; Auto-Inject"
                 Height="360"
                 Width="480"
                 MinHeight="320"
                 MinWidth="420"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Watch &amp; Auto-Inject" />
        <TextBlock Grid.Row="1" Margin="0,12,0,4" Text="Executable path or name" />
        <ui:TextBox Grid.Row="2"
                    PlaceholderText="game.exe or C:\Games\game.exe"
                    Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="3" Margin="0,12,0,4" Text="Inject" />
        <ComboBox Grid.Row="4"
                  DisplayMemberPath="Label"
                  ItemsSource="{Binding Triggers}"
                  SelectedValue="{Binding Trigger, Mode=TwoWay}"
                  SelectedValuePath="Trigger" />
        <TextBlock Grid.Row="5" Margin="0,12,0,4" Text="Delay after the trigger (0 to 30000 ms)" />
        <ui:TextBox Grid.Row="6"
                    PlaceholderText="0"
                    Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" />
        <DockPanel Grid.Row="7" Margin="0,12,0,0" LastChildFill="True" VerticalAlignment="Bottom">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="CancelButton_Click" />
                <ui:Button Appearance="Primary" Content="Arm Watch" Click="ArmButton_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Opacity="0.75" Text="{Binding DllSummary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="#FFD97706" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
