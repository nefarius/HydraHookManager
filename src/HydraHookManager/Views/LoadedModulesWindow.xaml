<ui:FluentWindow x:Class="HydraHookManager.Views.LoadedModulesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Loaded modules"
                 Height="520"
                 Width="780"
                 MinHeight="320"
                 MinWidth="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </ui:FluentWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Loaded modules" />
        <TextBlock Grid.Row="1" Text="{Binding Header}" FontWeight="SemiBold" Margin="0,8,0,8" />
        <TextBlock Grid.Row="2"
                   Text="{Binding AccessMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding ShowAccessMessage, Converter={StaticResource BooleanToVisibility}}" />
        <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="True">
            <ui:Button DockPanel.Dock="Right"
                       Content="Refresh"
                       Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RefreshCommand}" />
            <ui:TextBox PlaceholderText="Filter modules..."
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ui:ListView Grid.Row="4"
                     ItemsSource="{Binding Rows}"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ui:ListView.View>
                <ui:GridView>
                    <ui:GridViewColumn Header="Tag" Width="90">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tag}" Margin="6,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Header="Module" Width="180">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="6,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Header="Base" Width="110">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BaseAddress}" Margin="6,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Header="Size" Width="80">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Size}" Margin="6,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Header="Path" Width="220">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullPath}"
                                           Margin="6,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding FullPath}" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                    <ui:GridViewColumn Width="72">
                        <ui:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Eject"
                                           Padding="8,2"
                                           MinWidth="0"
                                           Command="{Binding DataContext.EjectCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding CanEject, Converter={StaticResource BooleanToVisibility}}" />
                            </DataTemplate>
                        </ui:GridViewColumn.CellTemplate>
                    </ui:GridViewColumn>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>
    </Grid>
</ui:FluentWindow>
