<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Framework-dependent publish must accept any 10.0.x Desktop Runtime, not the CI SDK patch. -->
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RollForward>LatestMajor</RollForward>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HydraHookManager</AssemblyName>
    <RootNamespace>HydraHookManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\HydraHook.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <!-- https://github.com/dotnet/runtime/issues/108589#issuecomment-2399641501 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\HydraHook.ico">
      <Link>Assets\HydraHook.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Injector\x86\Injector.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Injector\x86\Injector.exe</Link>
    </Content>
    <Content Include="Resources\Injector\x64\Injector.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Injector\x64\Injector.exe</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HydraHookManager.Tests" />
  </ItemGroup>

</Project>
