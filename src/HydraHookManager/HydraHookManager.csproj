<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HydraHookManager</AssemblyName>
    <RootNamespace>HydraHookManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\Injector\x86\Injector.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Injector\x86\Injector.exe</Link>
    </Content>
    <Content Include="Resources\Injector\x64\Injector.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Injector\x64\Injector.exe</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.0" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

</Project>
