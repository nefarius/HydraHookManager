<ui:FluentWindow x:Class="HydraHookManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="HydraHook Manager"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TitleBar Title="HydraHook Manager" />
        </StackPanel>

        <!-- Process list: grows/shrinks with window resize, docked top and bottom -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,0,0,16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
                    <ui:TextBox x:Name="ProcessFilterBox"
                               PlaceholderText="Filter by name..."
                               Width="200"
                               Margin="0,0,8,0"
                               TextChanged="ProcessFilterBox_TextChanged" />
                    <ui:Button x:Name="RefreshButton"
                               Content="Refresh"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshButton_Click" />
                </StackPanel>
                <DataGrid x:Name="ProcessGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Margin="12,0,12,12"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ProcessGrid_SelectionChanged"
                          IsSynchronizedWithCurrentItem="False"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}"
                                           Width="16"
                                           Height="16"
                                           Stretch="Uniform" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Arch" Binding="{Binding Architecture}" Width="80" />
                        <DataGridTextColumn Header="Window" Binding="{Binding WindowTitle}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:Card>

        <!-- DLL injection section: fixed height, below process list -->
        <ui:Card Grid.Row="2" Padding="12" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DLLs to inject" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="DllListBox"
                         Grid.Row="1"
                         Margin="0,0,0,8" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <ui:Button Content="Add DLL"
                               Icon="{ui:SymbolIcon Add24}"
                               Click="AddDllButton_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Remove"
                               Icon="{ui:SymbolIcon Delete24}"
                               Click="RemoveDllButton_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Bottom: Inject button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button x:Name="InjectButton"
                       Content="Inject"
                       Icon="{ui:SymbolIcon Flash24}"
                       Appearance="Primary"
                       Click="InjectButton_Click" />
        </StackPanel>

        <!-- Snackbar for injection feedback -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="4" />
    </Grid>
</ui:FluentWindow>
