<ui:FluentWindow x:Class="HydraHookManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:HydraHookManager"
        xmlns:views="clr-namespace:HydraHookManager.Views"
        xmlns:vm="clr-namespace:HydraHookManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="HydraHook Manager"
        Icon="pack://application:,,,/Assets/HydraHook.ico"
        Height="640"
        Width="1040"
        MinHeight="560"
        MinWidth="860"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <views:DepthToMarginConverter x:Key="DepthToMargin" />
        <views:BoolToAppearanceConverter x:Key="BoolToAppearance" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <views:AccessStateVisibilityConverter x:Key="AccessStateVisibility" />
        <views:InjectionBadgeVisibilityConverter x:Key="InjectionBadgeVisibility" />
        <views:InjectionBadgeTextConverter x:Key="InjectionBadgeText" />
        <views:InjectionBadgeBrushConverter x:Key="InjectionBadgeBrush" />
        <views:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <Style x:Key="ProcessItemStyle" TargetType="ui:ListViewItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ListViewItemForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ListViewItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ui:GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                         Content="{TemplateBinding Content}"
                                                         Columns="{TemplateBinding GridView.ColumnCollection}" />
                                <Rectangle x:Name="ActiveRectangle"
                                           Width="3"
                                           Height="16"
                                           Margin="2,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{DynamicResource ListViewItemPillFillBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsContextOnly}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0"
                     Title="HydraHook Manager"
                     Height="32"
                     Padding="12,0,8,0"
                     FontSize="14"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/HydraHook.ico'}" />
        <Grid x:Name="RootLayout" Grid.Row="1" Margin="16,8,16,16" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition x:Name="SplitterRow" Height="Auto" />
            <RowDefinition x:Name="DllPaneRow" Height="280" MinHeight="240" />
            <RowDefinition x:Name="ActionRow" Height="Auto" />
            <RowDefinition x:Name="SnackbarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <Border x:Name="WatchBanner"
                    Margin="0,0,0,8"
                    Padding="8,6"
                    CornerRadius="4"
                    Background="#22D97706"
                    Visibility="{Binding IsWatchArmed, Converter={StaticResource BooleanToVisibility}}"
                    SizeChanged="WatchBanner_SizeChanged">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Configure..."
                                   Margin="8,0,8,0"
                                   Command="{Binding ConfigureWatchCommand}" />
                        <ui:Button Content="Stop" Command="{Binding DisarmWatchCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding WatchStatusText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Process list: grows/shrinks with window resize, docked top and bottom -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,0,0,16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="ProcessFilterBox"
                               Grid.Column="0"
                               PlaceholderText="Filter by name, window, PID, or path..."
                               Margin="0,0,8,0"
                               TextChanged="ProcessFilterBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Windowed"
                                   Margin="0,0,8,0"
                                   ToolTip="Show only processes with a visible window"
                                   Appearance="{Binding ShowWindowedOnly, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleWindowedOnlyCommand}" />
                        <ui:Button Content="Direct3D"
                                   Margin="0,0,8,0"
                                   ToolTip="Show only processes with Direct3D or DXGI loaded"
                                   Appearance="{Binding ShowDirect3DOnly, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleDirect3DOnlyCommand}" />
                        <ui:Button Content="Injected"
                                   Margin="0,0,8,0"
                                   ToolTip="Show only processes this manager has injected"
                                   Appearance="{Binding ShowInjectedOnly, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleInjectedOnlyCommand}" />
                        <ui:Button Content="Tree"
                                   Margin="0,0,8,0"
                                   ToolTip="Group processes under the process that started them"
                                   Appearance="{Binding IsTreeView, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleTreeViewCommand}" />
                        <ui:Button Content="Auto"
                                   Margin="0,0,8,0"
                                   ToolTip="Refresh the list automatically while this window is open"
                                   Appearance="{Binding IsAutoRefreshEnabled, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleAutoRefreshCommand}" />
                        <ui:Button x:Name="RefreshButton"
                                   Content="Refresh"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding VisibleProcessCount, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text=" / " VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalProcessCount, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ui:ListView x:Name="ProcessListView"
                             Grid.Row="1"
                             Margin="12,0,12,12"
                             BorderThickness="0"
                             SelectionMode="Single"
                             IsSynchronizedWithCurrentItem="False"
                             ItemsSource="{Binding VisibleProcesses}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             IsTextSearchEnabled="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="10,10"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             ItemContainerStyle="{StaticResource ProcessItemStyle}"
                             GridViewColumnHeader.Click="ProcessListView_ColumnHeaderClick"
                             ContextMenuOpening="ProcessListView_ContextMenuOpening"
                             SizeChanged="ProcessListView_SizeChanged">
                    <ui:ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Inject configured DLLs" Command="{Binding InjectCommand}" />
                            <MenuItem Header="Eject configured DLLs" Command="{Binding EjectCommand}" />
                            <MenuItem Header="Watch &amp; Auto-Inject this executable..." Command="{Binding WatchSelectedProcessCommand}" />
                            <MenuItem Header="Eject loaded DLL" ItemsSource="{Binding SelectedProcess.InjectedDlls}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}" />
                                        <Setter Property="Command" Value="{Binding Data.EjectDllCommand, Source={StaticResource ViewModelProxy}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Inspect Loaded Modules..." Command="{Binding InspectModulesCommand}" />
                            <MenuItem Header="Bring Window to Front" Command="{Binding BringWindowToFrontCommand}" />
                            <MenuItem Header="Open File Location" Command="{Binding OpenFileLocationCommand}" />
                            <MenuItem Header="Copy PID" Command="{Binding CopyPidCommand}" />
                            <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" />
                        </ContextMenu>
                    </ui:ListView.ContextMenu>
                    <ui:ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling"
                                                    ScrollUnit="Pixel"
                                                    CacheLength="10,10"
                                                    CacheLengthUnit="Item" />
                        </ItemsPanelTemplate>
                    </ui:ListView.ItemsPanel>
                    <ui:ListView.View>
                        <ui:GridView>
                            <ui:GridViewColumn Width="36">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon, Mode=OneWay}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               SnapsToDevicePixels="True" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="NameColumn"
                                               local:ProcessSort.Key="Name"
                                               local:ProcessSort.Label="Name"
                                               Header="Name"
                                               Width="220"
                                               MinWidth="160">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,2,0" VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsTreeView, RelativeSource={RelativeSource AncestorType=ui:ListView}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ui:Button Width="16"
                                                           Height="16"
                                                           MinWidth="16"
                                                           MinHeight="16"
                                                           Padding="0"
                                                           BorderThickness="0"
                                                           Focusable="True"
                                                           Appearance="Transparent"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibility}}">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="ChevronRight24"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource InverseBooleanToVisibility}}" />
                                                        <ui:SymbolIcon Symbol="ChevronDown24"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}" />
                                                    </Grid>
                                                </ui:Button>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name, Mode=OneTime}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Shield24"
                                                               FontSize="14"
                                                               Margin="4,0,0,0"
                                                               ToolTip="This process requires administrator rights"
                                                               Visibility="{Binding AccessState, Converter={StaticResource AccessStateVisibility}, ConverterParameter=admin}" />
                                                <ui:SymbolIcon Symbol="LockClosed24"
                                                               FontSize="14"
                                                               Margin="4,0,0,0"
                                                               ToolTip="This process is protected and cannot be opened"
                                                               Visibility="{Binding AccessState, Converter={StaticResource AccessStateVisibility}, ConverterParameter=protected}" />
                                                <Border Margin="4,0,0,0"
                                                        Padding="4,0"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding InjectionState, Converter={StaticResource InjectionBadgeBrush}}"
                                                        ToolTip="{Binding InjectionTooltip}"
                                                        Visibility="{Binding InjectionState, Converter={StaticResource InjectionBadgeVisibility}}">
                                                    <TextBlock FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding InjectionState, Converter={StaticResource InjectionBadgeText}}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Id"
                                               local:ProcessSort.Label="PID"
                                               Header="PID"
                                               Width="68">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Architecture"
                                               local:ProcessSort.Label="Arch"
                                               Header="Arch"
                                               Width="96">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Architecture, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="GraphicsApi"
                                               local:ProcessSort.Label="Graphics"
                                               Header="Graphics"
                                               Width="92">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GraphicsApi, Mode=OneWay}"
                                                   Margin="6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="WindowColumn"
                                               local:ProcessSort.Key="WindowTitle"
                                               local:ProcessSort.Label="Window"
                                               Header="Window"
                                               Width="260"
                                               MinWidth="180">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WindowTitle, Mode=OneWay}"
                                                   Margin="6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                        </ui:GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>
        </ui:Card>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      DragCompleted="DllPaneSplitter_DragCompleted"
                      KeyUp="DllPaneSplitter_KeyUp" />

        <!-- DLL injection section: height follows the splitter and is saved with the window. -->
        <ui:Card Grid.Row="3" Padding="12" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="DLLs to inject" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DllSelectionSummary}"
                               Margin="12,0,0,0"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True" VerticalAlignment="Top">
                    <ui:Button DockPanel.Dock="Right"
                               Content="Watch..."
                               Margin="8,0,0,0"
                               ToolTip="Watch an executable and inject the checked DLLs into each new launch"
                               Command="{Binding ConfigureWatchCommand}" />
                    <ui:Button DockPanel.Dock="Right"
                               Content="Delete"
                               Margin="8,0,0,0"
                               Command="{Binding DeleteActiveProfileCommand}" />
                    <ui:Button DockPanel.Dock="Right"
                               Content="Save"
                               Margin="8,0,0,0"
                               Click="SaveProfileButton_Click" />
                    <Grid MinWidth="160" VerticalAlignment="Center">
                        <ComboBox ToolTip="Saved DLL list. Save names the DLLs that are checked now."
                                  IsEnabled="{Binding HasSavedProfiles}"
                                  ItemsSource="{Binding ProfileNames}"
                                  SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}" />
                        <TextBlock Margin="8,0,28,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   Text="No saved profile">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfileName}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <ListBox x:Name="DllListBox"
                         Grid.Row="2"
                         Margin="0,0,0,8"
                         AllowDrop="True"
                         ItemsSource="{Binding DllItems}"
                         SelectedItem="{Binding SelectedDll, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         DragOver="DllListBox_DragOver"
                         Drop="DllListBox_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="DllRow" ToolTip="{Binding StatusTooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                    <Grid Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Path}"
                                                   Opacity="0.65"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ArchBadge"
                                                Margin="4,0,0,0"
                                                Padding="4,0"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="#22000000"
                                                Visibility="{Binding ShowArchitecture, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock FontSize="11" Text="{Binding ArchitectureLabel}" />
                                        </Border>
                                        <Border Margin="4,0,0,0"
                                                Padding="4,0"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="#44D97706"
                                                Visibility="{Binding ShowFileStatus, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock FontSize="11" Text="{Binding FileStatusLabel}" />
                                        </Border>
                                        <Border Margin="4,0,0,0"
                                                Padding="4,0"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="#443CB06B"
                                                ToolTip="Loaded in the selected process"
                                                Visibility="{Binding IsLoadedInSelected, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock FontSize="11" Text="Loaded" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsArchitectureMismatch}" Value="True">
                                    <Setter TargetName="ArchBadge" Property="Background" Value="#44D97706" />
                                    <Setter TargetName="DllRow" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                    <Setter TargetName="DllRow" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowFileStatus}" Value="True">
                                    <Setter TargetName="DllRow" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <ui:Button Content="Add DLL"
                               Icon="{ui:SymbolIcon Add24}"
                               Click="AddDllButton_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Remove"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding RemoveSelectedDllCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Bottom: actions -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="Inject"
                           Icon="{ui:SymbolIcon Flash24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding InjectCommand}" />
                <ui:Button Content="Eject"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           Command="{Binding EjectCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Running as Administrator"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsElevated, Converter={StaticResource BooleanToVisibility}}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Restart as Admin"
                           Icon="{ui:SymbolIcon Shield24}"
                           Margin="0,0,8,0"
                           Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource BooleanToVisibility}}"
                           Command="{Binding RestartAsAdminCommand}" />
                <ui:Button Content="Check for updates"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="0,0,8,0"
                           Command="{Binding CheckForUpdatesCommand}" />
                <ui:Button Content="Logs"
                           Icon="{ui:SymbolIcon Folder24}"
                           Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- Snackbar for injection feedback -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="5" SizeChanged="SnackbarPresenter_SizeChanged" />

        <!-- Host for content dialogs (update prompt) -->
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="6" />
        </Grid>
    </Grid>
</ui:FluentWindow>
