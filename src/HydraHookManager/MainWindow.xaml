<ui:FluentWindow x:Class="HydraHookManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:HydraHookManager"
        xmlns:views="clr-namespace:HydraHookManager.Views"
        xmlns:vm="clr-namespace:HydraHookManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="HydraHook Manager"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="700"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <views:DepthToMarginConverter x:Key="DepthToMargin" />
        <views:BoolToAppearanceConverter x:Key="BoolToAppearance" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <Style x:Key="ProcessItemStyle" TargetType="ui:ListViewItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ListViewItemForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ListViewItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ui:GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                         Content="{TemplateBinding Content}"
                                                         Columns="{TemplateBinding GridView.ColumnCollection}" />
                                <Rectangle x:Name="ActiveRectangle"
                                           Width="3"
                                           Height="16"
                                           Margin="2,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{DynamicResource ListViewItemPillFillBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsContextOnly}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TitleBar Title="HydraHook Manager" />
        </StackPanel>

        <!-- Process list: grows/shrinks with window resize, docked top and bottom -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,0,0,16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="ProcessFilterBox"
                               Grid.Column="0"
                               PlaceholderText="Filter by name, window, PID, or path..."
                               Margin="0,0,8,0"
                               TextChanged="ProcessFilterBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Windowed"
                                   Margin="0,0,8,0"
                                   ToolTip="Show only processes with a visible window"
                                   Appearance="{Binding ShowWindowedOnly, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleWindowedOnlyCommand}" />
                        <ui:Button Content="Tree"
                                   Margin="0,0,8,0"
                                   ToolTip="Group processes under the process that started them"
                                   Appearance="{Binding IsTreeView, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleTreeViewCommand}" />
                        <ui:Button Content="Auto"
                                   Margin="0,0,8,0"
                                   ToolTip="Refresh the list automatically while this window is open"
                                   Appearance="{Binding IsAutoRefreshEnabled, Converter={StaticResource BoolToAppearance}}"
                                   Command="{Binding ToggleAutoRefreshCommand}" />
                        <ui:Button x:Name="RefreshButton"
                                   Content="Refresh"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding VisibleProcessCount, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text=" / " VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalProcessCount, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ui:ListView x:Name="ProcessListView"
                             Grid.Row="1"
                             Margin="12,0,12,12"
                             BorderThickness="0"
                             SelectionMode="Single"
                             IsSynchronizedWithCurrentItem="False"
                             ItemsSource="{Binding VisibleProcesses}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             IsTextSearchEnabled="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="10,10"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             ItemContainerStyle="{StaticResource ProcessItemStyle}"
                             GridViewColumnHeader.Click="ProcessListView_ColumnHeaderClick"
                             SizeChanged="ProcessListView_SizeChanged">
                    <ui:ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling"
                                                    ScrollUnit="Pixel"
                                                    CacheLength="10,10"
                                                    CacheLengthUnit="Item" />
                        </ItemsPanelTemplate>
                    </ui:ListView.ItemsPanel>
                    <ui:ListView.View>
                        <ui:GridView>
                            <ui:GridViewColumn Width="36">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon, Mode=OneWay}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               SnapsToDevicePixels="True" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="NameColumn"
                                               local:ProcessSort.Key="Name"
                                               local:ProcessSort.Label="Name"
                                               Header="Name"
                                               Width="220"
                                               MinWidth="160">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                                            <Grid Width="16" Height="16" Margin="0,0,2,0" VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsTreeView, RelativeSource={RelativeSource AncestorType=ui:ListView}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ui:Button Width="16"
                                                           Height="16"
                                                           MinWidth="16"
                                                           MinHeight="16"
                                                           Padding="0"
                                                           BorderThickness="0"
                                                           Focusable="False"
                                                           Appearance="Transparent"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibility}}">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="ChevronRight24"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource InverseBooleanToVisibility}}" />
                                                        <ui:SymbolIcon Symbol="ChevronDown24"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}" />
                                                    </Grid>
                                                </ui:Button>
                                            </Grid>
                                            <TextBlock Text="{Binding Name, Mode=OneTime}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Id"
                                               local:ProcessSort.Label="PID"
                                               Header="PID"
                                               Width="68">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Architecture"
                                               local:ProcessSort.Label="Arch"
                                               Header="Arch"
                                               Width="96">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Architecture, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="WindowColumn"
                                               local:ProcessSort.Key="WindowTitle"
                                               local:ProcessSort.Label="Window"
                                               Header="Window"
                                               Width="260"
                                               MinWidth="180">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WindowTitle, Mode=OneWay}"
                                                   Margin="6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                        </ui:GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>
        </ui:Card>

        <!-- DLL injection section: fixed height, below process list -->
        <ui:Card Grid.Row="2" Padding="12" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DLLs to inject" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="DllListBox"
                         Grid.Row="1"
                         Margin="0,0,0,8"
                         AllowDrop="True"
                         ItemsSource="{Binding DllPaths}"
                         SelectedItem="{Binding SelectedDll, Mode=TwoWay}"
                         DragOver="DllListBox_DragOver"
                         Drop="DllListBox_Drop" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <ui:Button Content="Add DLL"
                               Icon="{ui:SymbolIcon Add24}"
                               Click="AddDllButton_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Remove"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding RemoveSelectedDllCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Bottom: actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="Inject"
                           Icon="{ui:SymbolIcon Flash24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding InjectCommand}" />
                <ui:Button Content="Eject"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           Command="{Binding EjectCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Running as Administrator"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsElevated, Converter={StaticResource BooleanToVisibility}}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Restart as Admin"
                           Icon="{ui:SymbolIcon Shield24}"
                           Margin="0,0,8,0"
                           Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource BooleanToVisibility}}"
                           Command="{Binding RestartAsAdminCommand}" />
                <ui:Button Content="Check for updates"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="0,0,8,0"
                           Command="{Binding CheckForUpdatesCommand}" />
                <ui:Button Content="Logs"
                           Icon="{ui:SymbolIcon Folder24}"
                           Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- Snackbar for injection feedback -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="4" />

        <!-- Host for content dialogs (update prompt) -->
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="5" />
    </Grid>
</ui:FluentWindow>
