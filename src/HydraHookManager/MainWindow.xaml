<ui:FluentWindow x:Class="HydraHookManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:HydraHookManager"
        Title="HydraHook Manager"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="700">
    <ui:FluentWindow.Resources>
        <Style x:Key="ProcessItemStyle" TargetType="ui:ListViewItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ListViewItemForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ListViewItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ui:GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                         Content="{TemplateBinding Content}"
                                                         Columns="{TemplateBinding GridView.ColumnCollection}" />
                                <Rectangle x:Name="ActiveRectangle"
                                           Width="3"
                                           Height="16"
                                           Margin="2,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{DynamicResource ListViewItemPillFillBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TitleBar Title="HydraHook Manager" />
        </StackPanel>

        <!-- Process list: grows/shrinks with window resize, docked top and bottom -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,0,0,16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
                    <ui:TextBox x:Name="ProcessFilterBox"
                               PlaceholderText="Filter by name..."
                               Width="200"
                               Margin="0,0,8,0"
                               TextChanged="ProcessFilterBox_TextChanged" />
                    <ui:Button x:Name="RefreshButton"
                               Content="Refresh"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshButton_Click" />
                </StackPanel>
                <ui:ListView x:Name="ProcessListView"
                             Grid.Row="1"
                             Margin="12,0,12,12"
                             BorderThickness="0"
                             SelectionMode="Single"
                             IsSynchronizedWithCurrentItem="False"
                             SelectionChanged="ProcessListView_SelectionChanged"
                             IsTextSearchEnabled="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="10,10"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             ItemContainerStyle="{StaticResource ProcessItemStyle}"
                             GridViewColumnHeader.Click="ProcessListView_ColumnHeaderClick"
                             SizeChanged="ProcessListView_SizeChanged">
                    <ui:ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    VirtualizationMode="Recycling"
                                                    ScrollUnit="Pixel"
                                                    CacheLength="10,10"
                                                    CacheLengthUnit="Item" />
                        </ItemsPanelTemplate>
                    </ui:ListView.ItemsPanel>
                    <ui:ListView.View>
                        <ui:GridView>
                            <ui:GridViewColumn Width="36">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon, Mode=OneWay}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               SnapsToDevicePixels="True" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="NameColumn"
                                               local:ProcessSort.Key="Name"
                                               local:ProcessSort.Label="Name"
                                               Header="Name"
                                               Width="220"
                                               MinWidth="160">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, Mode=OneTime}"
                                                   Margin="6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Id"
                                               local:ProcessSort.Label="PID"
                                               Header="PID"
                                               Width="68">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn local:ProcessSort.Key="Architecture"
                                               local:ProcessSort.Label="Arch"
                                               Header="Arch"
                                               Width="72">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Architecture, Mode=OneTime}"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn x:Name="WindowColumn"
                                               local:ProcessSort.Key="WindowTitle"
                                               local:ProcessSort.Label="Window"
                                               Header="Window"
                                               Width="260"
                                               MinWidth="180">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WindowTitle, Mode=OneTime}"
                                                   Margin="6,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                        </ui:GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>
        </ui:Card>

        <!-- DLL injection section: fixed height, below process list -->
        <ui:Card Grid.Row="2" Padding="12" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DLLs to inject" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="DllListBox"
                         Grid.Row="1"
                         Margin="0,0,0,8" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <ui:Button Content="Add DLL"
                               Icon="{ui:SymbolIcon Add24}"
                               Click="AddDllButton_Click"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Remove"
                               Icon="{ui:SymbolIcon Delete24}"
                               Click="RemoveDllButton_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Bottom: Inject button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button x:Name="InjectButton"
                       Content="Inject"
                       Icon="{ui:SymbolIcon Flash24}"
                       Appearance="Primary"
                       Click="InjectButton_Click" />
        </StackPanel>

        <!-- Snackbar for injection feedback -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="4" />
    </Grid>
</ui:FluentWindow>
